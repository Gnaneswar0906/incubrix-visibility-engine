# ==============================================================================
# IncuBrix AEO, SEO & GEO Visibility Engine - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your API credentials.
# Note: The engine includes a high-fidelity offline mock fallback. If keys are
# not provided, the engine runs completely offline with realistic simulated data.

# ------------------------------------------------------------------------------
# SERP Providers (Google Search & AI Overview)
# ------------------------------------------------------------------------------
# Free tier key from https://serper.dev/
SERPER_API_KEY=

# BrightData SERP API credentials (optional alternative)
BRIGHTDATA_API_KEY=
BRIGHTDATA_ZONE=

# ------------------------------------------------------------------------------
# LLM Providers (ChatGPT, Gemini, Perplexity, Claude/Copilot)
# ------------------------------------------------------------------------------
# OpenAI API Key (ChatGPT)
OPENAI_API_KEY=

# Google Gemini API Key
GEMINI_API_KEY=

# Perplexity API Key
PERPLEXITY_API_KEY=

# Anthropic Claude API Key (Claude / Copilot)
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# Alerting & Webhook Notifications
# ------------------------------------------------------------------------------
# Slack or Discord webhook for weekly tracker alerts
ALERT_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# Engine Execution Flags
# ------------------------------------------------------------------------------
# Set to 'true' to force offline mode without calling external APIs
OFFLINE_MODE=true

# Set to 'true' to simulate network failure and test exponential backoff recovery
SIMULATE_FAILURE=false
